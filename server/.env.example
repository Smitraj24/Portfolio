# Contact form – receive submissions at your email
# Copy this file to .env and fill in your values. Do not commit .env.

# Your Gmail address (used as SMTP user and default recipient)
SMTP_USER=your_email
# Gmail App Password (not your normal password).
# Create one at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_password
# Optional: email where contact messages are sent (defaults to SMTP_USER)
CONTACT_TO_EMAIL=makvanasmitrajsinh@gmail.com

# Optional: server port (default)
PORT=your-port
